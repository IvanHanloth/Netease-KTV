# Netease KTV settings. The start scripts create .env from this file; all values are optional.

# Host port for the web app.
KTV_PORT=8686

# Separation on NVIDIA GPU: auto (detect) | on | off
KTV_GPU=auto

# Run a separator on this machine: on | off. With off, add separator servers on other machines
# in 后台管理 (/admin) -> 分离服务器; without any, songs play with the original vocals.
KTV_SEPARATOR=on

# LAN address shown in the "scan to request songs" QR code, e.g. http://192.168.1.8:8686
# Leave empty to let the start script detect it. Can also be set in the app's settings.
PUBLIC_URL=

# HTTPS with your own domain on Cloudflare (Caddy issues the certificate; see README → HTTPS).
# Point a DNS-only (grey cloud) A record at this machine's LAN IP, then fill in both values.
# The start scripts then add docker-compose.https.yml and the QR code uses https://KTV_DOMAIN.
KTV_DOMAIN=
# Cloudflare API token with Zone → DNS → Edit permission on that domain's zone.
CF_API_TOKEN=
# Host port for HTTPS (anything other than 443 shows up in the address, e.g. https://ktv.example.com:8443).
KTV_HTTPS_PORT=443

# Optional access token. When set, the QR code carries it and API calls without it are rejected.
ACCESS_TOKEN=

# NetEase audio quality: standard | higher | exhigh | lossless | hires
AUDIO_LEVEL=exhigh

# Separation model (empty = auto: Mel-Band RoFormer karaoke on GPU, UVR_MDXNET_KARA_2 on CPU).
SEPARATOR_MODEL=

# Third-party sources for songs NetEase has NO source for. Off by default.
# Never used for VIP / paid songs. Song ids are sent to third-party sites. Personal use only.
ENABLE_UNBLOCK=false
UNBLOCK_SOURCES=unm

# Mic-based pitch scoring on the TV (needs the TV page opened via localhost or HTTPS).
SCORING_ENABLED=true
# Pitch error in semitones that still earns full points (0.3-3; 1.5 loose, 1.0 normal, 0.5 strict).
SCORE_TOLERANCE=1.0

# Download MVs of queued songs ahead of time (smooth playback + automatic MV/song alignment).
MV_PRELOAD=true
# MV resolution: 480 | 720 | 1080
MV_RESOLUTION=720
# Disk space for cached audio, stems and MVs; least recently used songs are removed first.
CACHE_LIMIT_GB=20
