{
  "id": "/tv",
  "name": "Netease KTV 大屏",
  "short_name": "KTV 大屏",
  "description": "KTV 播放大屏：伴奏、歌词和 MV",
  "start_url": "/tv",
  "display": "fullscreen",
  "display_override": [
    "window-controls-overlay"
  ],
  "orientation": "landscape",
  "scope": "/",
  "lang": "zh-CN",
  "dir": "ltr",
  "background_color": "#0A0A0F",
  "theme_color": "#0A0A0F",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "music",
    "entertainment"
  ]
}
